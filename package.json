{
  "name": "tmuxgo",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "env:check": "node -e \"const[a,b]=process.versions.node.split('.').map(Number);if(!((a===20&&b>=19)||(a===22&&b>=12)||a>=24)){console.error('Unsupported Node.js '+process.version+'. Need ^20.19 || ^22.12 || >=24');process.exit(1)}console.log('Node.js '+process.version+' OK')\"",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:gateway": "npm run dev --workspace=gateway",
    "dev:agent": "npm run dev --workspace=agent",
    "build": "npm run build --workspaces --if-present",
    "build:frontend": "npm run build --workspace=frontend",
    "build:frontend:stable": "npm run build --workspace=frontend",
    "build:gateway": "npm run build --workspace=gateway",
    "build:agent": "npm run build --workspace=agent",
    "restart:stable": "./start.sh --restart",
    "deploy:frontend": "./start.sh --restart --rebuild",
    "build:npx": "bash scripts/prepare-npx-package.sh",
    "pack:npx": "npm pack --workspace=@21hbguo/tmuxgo",
    "publish:npx": "npm publish --workspace=@21hbguo/tmuxgo --access public",
    "test:frontend": "npm run test --workspace=frontend",
    "test:e2e": "tsx scripts/run-e2e.ts && npm run test:auth-e2e && npm run test:default-auth-e2e && npm run test:auth-restart-e2e && npm run test:agent-e2e",
    "test:auth-e2e": "tsx scripts/run-auth-e2e.ts",
    "test:default-auth-e2e": "TMUXGO_AUTH_E2E_USERNAME=admin TMUXGO_AUTH_E2E_PASSWORD=admin123 TMUXGO_AUTH_E2E_TESTS=e2e/default-password.spec.ts tsx scripts/run-auth-e2e.ts",
    "test:auth-restart-e2e": "TMUXGO_AUTH_E2E_TESTS=e2e/auth-restart-login.spec.ts TMUXGO_AUTH_E2E_RESTART_TESTS=e2e/auth-restart-check.spec.ts tsx scripts/run-auth-e2e.ts",
    "test:agent-e2e": "tsx scripts/run-agent-e2e.ts",
    "test:ssh-e2e": "tsx scripts/run-ssh-e2e.ts",
    "test:fluency-e2e": "tsx scripts/run-e2e.ts e2e/fluency.spec.ts",
    "verify:fluency": "npx tsx scripts/verify-fluency-metrics.ts",
    "proto:status": "npx tsx scripts/tmux-pane-status-prototype.ts",
    "proto:state": "npx tsx scripts/tmux-pane-state.ts",
    "test": "npx tsx scripts/run-tests.ts",
    "test:smoke": "tsx scripts/run-e2e.ts e2e/pr-smoke.spec.ts && TMUXGO_AUTH_E2E_TESTS=e2e/auth-smoke.spec.ts tsx scripts/run-auth-e2e.ts",
    "measure:perf": "tsx scripts/measure-perf.ts",
    "postinstall": "bash scripts/fix-native-perms.sh && simple-git-hooks",
    "smoke:pty": "node scripts/smoke-node-pty.mjs",
    "lint": "eslint .",
    "check:eslint-warnings": "tsx scripts/check-eslint-warnings.ts",
    "typecheck": "tsc -p apps/frontend/tsconfig.json && tsc -p apps/gateway/tsconfig.json --noEmit && tsc -p apps/agent/tsconfig.json --noEmit",
    "verify": "npm test && npm run test:frontend && npm run test:e2e && npm run build"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "simple-git-hooks": "^2.14.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7"
  }
}
